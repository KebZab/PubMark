{
  "expo": {
    "name": "PubMark",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pubmark-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pubmark.mobile"
    },
    "android": {
      "package": "com.pubmark.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#14B8A6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f0fdfa",
          "image": "./assets/pubmark-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.635844852444-j0sifciish4jb2fe9ulrvudculvmvugq"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a416c5ce-f6d8-4b2c-8887-badf4ec736e4"
      }
    },
    "owner": "pubmark"
  }
}
