# The browser must never receive database credentials — it only ever talks
# to the Express API below, which is the sole thing that connects to
# Postgres/Supabase Storage. See server/.env.example for those credentials.
VITE_API_BASE_URL=http://localhost:4000/api

# "Sign in with Google" — OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Web application,
# with this app's origin e.g. http://localhost:5173 added to "Authorized
# JavaScript origins"). Safe to expose to the browser — Client IDs are
# public by design; this app never needs the paired Client Secret since it
# only uses the ID-token flow, no server-side authorization-code exchange.
# Must match GOOGLE_CLIENT_ID in server/.env exactly. Leave blank to keep
# the Google sign-in button hidden.
VITE_GOOGLE_CLIENT_ID=
