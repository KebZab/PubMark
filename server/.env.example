# Copy this file to server/.env and fill in the real values.
# Ask the project owner for the actual DATABASE_URL and JWT_SECRET —
# never commit server/.env itself, it's gitignored on purpose.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Postgres connection string for the shared Supabase project.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host.supabase.com:5432/postgres

# Any long random string works, but must be the same value everyone on the
# team uses, or sessions signed by one person won't validate for another.
JWT_SECRET=ask-the-project-owner-for-the-real-value

# Used for uploading payment receipts to Supabase Storage (server-side only —
# the service role key must NEVER be exposed to the browser). Find both in the
# Supabase dashboard: Settings -> API. SUPABASE_URL is the "Project URL";
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key (not "anon").
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ask-the-project-owner-for-the-real-value

# Gmail SMTP for outgoing account-confirmation emails (super-admin-created
# accounts). Leave blank in local dev — the confirmation link is printed to
# the server console instead of emailed. To send real email: enable 2FA on
# the sending Gmail account and generate an App Password for GMAIL_APP_PASSWORD.
# Unlike a free-tier transactional email API, this can send to ANY recipient
# immediately — no domain verification needed.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Base URL used to build the confirmation link in the email. Defaults to
# http://localhost:<PORT> when unset.
API_PUBLIC_URL=

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application).
# Used only as the `audience` when verifying a Google ID token server-side —
# not secret (it's already embedded in every token's own `aud` claim), but
# kept server-side per this project's existing env-var conventions. Must
# match VITE_GOOGLE_CLIENT_ID in the root .env.local exactly. Leave blank to
# keep "Sign in with Google" disabled (the button hides itself client-side).
GOOGLE_CLIENT_ID=
